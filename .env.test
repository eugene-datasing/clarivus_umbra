# E2E test environment
DATABASE_URL="postgresql://veil:veil_dev@localhost:5434/veil"
AUTH_SECRET=veil-e2e-test-secret
BASE_URL=http://localhost:3000

# Storage (local filesystem for tests)
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports

# Disable Azure AD SSO — use credentials login for E2E tests
# AZURE_AD_CLIENT_ID is intentionally unset

# Azure services are mocked at the API route level in test mode.
# Set these only if running integration tests against real services:
# AZURE_OPENAI_ENDPOINT=...
# AZURE_OPENAI_KEY=...
# AZURE_DI_ENDPOINT=...
# AZURE_DI_KEY=...
