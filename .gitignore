# test-fixtures/: ignore everything by default (local scratch + per-dev
# fixture packs stay out of the index), then explicitly re-include files
# committed for shared test / spike use.  Using `test-fixtures/*` rather
# than `test-fixtures/` so sub-path negations below work — git cannot
# re-include a file under a fully-excluded directory.
test-fixtures/*
!test-fixtures/phase2-spike/
test-fixtures/phase2-spike/*
!test-fixtures/phase2-spike/large-23pg.docx
!test-fixtures/phase2-spike/small-1pg.docx
!test-fixtures/phase2-spike/small-2pg.docx
!test-fixtures/phase2-spike/small-3pg.docx
!test-fixtures/dummy-lgoima-pack/
test-fixtures/dummy-lgoima-pack/*
!test-fixtures/dummy-lgoima-pack/B2_Witness_Statement_Torres.pdf
!test-fixtures/bench/
test-fixtures/bench/*
!test-fixtures/bench/A_Council_Memo_Candid_Advice.docx
!test-fixtures/bench/A.expected.json
!test-fixtures/bench/B1_HR_Investigation_Report_Kellogg_Ferguson.docx
!test-fixtures/bench/B1.expected.json
!test-fixtures/bench/B2_Witness_Statement_Torres.pdf
