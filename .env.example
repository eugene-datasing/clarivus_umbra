# Umbra environment template — copy to .env and fill in.
#
# All variables here are validated by lib/config/env.ts on server startup.
# Build-time validation is skipped when NEXT_PHASE=phase-production-build
# (the Next.js production build doesn't have runtime secrets).

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------

DATABASE_URL="postgresql://umbra:umbra_dev@localhost:5434/umbra"

# ---------------------------------------------------------------------------
# Auth (required)
# ---------------------------------------------------------------------------

# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# ---------------------------------------------------------------------------
# Azure OpenAI (required for AI detection in dev + prod)
# ---------------------------------------------------------------------------

AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_KEY=""
AZURE_OPENAI_DEPLOYMENT="gpt-4o"

# Optional overrides:
# AZURE_OPENAI_DEPLOYMENT_DETECTION=""        # detection-specific deployment
# AZURE_OPENAI_DEPLOYMENT_CLASSIFICATION=""   # doc-classify-specific deployment
# AI_DETECT_SINGLE_BATCH_MAX_PAGES="6"        # single-call cap (default 6)
# AI_DETECT_CONCURRENCY="2"                   # parallel batches per doc (default 2)

# ---------------------------------------------------------------------------
# Azure Document Intelligence (required for OCR)
# ---------------------------------------------------------------------------

AZURE_DI_ENDPOINT=""
AZURE_DI_KEY=""

# ---------------------------------------------------------------------------
# Azure AD SSO (optional in dev; required in prod)
# ---------------------------------------------------------------------------

AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# ---------------------------------------------------------------------------
# Storage (optional — falls back to local filesystem if unset)
# ---------------------------------------------------------------------------

# Use either CONNECTION_STRING (preferred) or ACCOUNT_NAME + ACCOUNT_KEY
# AZURE_STORAGE_CONNECTION_STRING=""
# AZURE_STORAGE_ACCOUNT_NAME=""
# AZURE_STORAGE_ACCOUNT_KEY=""
# AZURE_STORAGE_CONTAINER="umbra-documents"

# Local filesystem fallback (dev only)
# UPLOAD_DIR="./uploads"

# ---------------------------------------------------------------------------
# Email — Azure Communication Services (optional)
# ---------------------------------------------------------------------------

# AZURE_COMMUNICATION_CONNECTION_STRING=""

# ---------------------------------------------------------------------------
# Telemetry — Application Insights (optional)
# ---------------------------------------------------------------------------

# APPLICATIONINSIGHTS_CONNECTION_STRING=""
