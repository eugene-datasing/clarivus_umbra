generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// MODELS — Umbra 0001_init (forked from Veil)
// ============================================================
//
// Phase 2 of the Veil → Umbra rework. Disclosure-workflow models
// (Department, CaseMilestone, CaseAssignment, DetectionSnapshot,
// FeedbackExample, ProcessingJob) are dropped. Case is renamed to
// Batch and caseId → batchId across the FK graph. Soft-delete +
// purge-state columns are added to Batch in preparation for the
// Phase 6 retention worker. AuditEntry, ExportJob, and FileUpload
// now cascade on Batch delete.

model User {
  id           String   @id @default(cuid())
  name         String
  email        String?  @unique
  passwordHash String?
  role         String   @default("reviewer")
  azureAdOid   String?  @unique
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedDocuments Document[]   @relation("DocumentAssignee")
  auditEntries      AuditEntry[]

  @@map("users")
}

model Batch {
  id             String   @id @default(cuid())
  reference      String   @unique
  name           String   // user-supplied batch name (e.g. "May submission responses"); per US-002. Length enforced at Zod layer in later phases.
  status         String   @default("draft")

  // Denormalized counters
  documentCount  Int @default(0)
  reviewedCount  Int @default(0)
  redactionCount Int @default(0)

  // Soft-delete + retention worker state (Phase 6 wires these up).
  // purgeStatus values constrained in app code: null | "scheduled" | "purging" | "archived"
  deletedAt        DateTime?
  purgeScheduledAt DateTime?
  purgedAt         DateTime?
  purgeStatus      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents    Document[]
  auditEntries AuditEntry[]
  milestones   BatchMilestone[]
  exportJobs   ExportJob[]
  fileUploads  FileUpload[]

  @@index([deletedAt])
  @@index([purgeScheduledAt])
  @@map("batches")
}

model Document {
  id              String  @id @default(cuid())
  batchId         String
  name            String
  fileType        String
  mimeType        String  @default("application/octet-stream")
  sizeBytes       Int     @default(0)
  pageCount       Int     @default(0)
  status          String  @default("pending")
  originalPath    String?
  processingError String?

  // Canonical PDF — one-PDF-per-document viewer rework
  canonicalPdfPath           String?  @map("canonical_pdf_path")
  canonicalPdfSha256         String?  @map("canonical_pdf_sha256")
  canonicalPdfPageCount      Int?     @map("canonical_pdf_page_count")
  canonicalPdfBuildMs        Int?     @map("canonical_pdf_build_ms")
  canonicalPdfSource         String?  @map("canonical_pdf_source") // "original" | "libreoffice" | "email-template"
  canonicalPdfTextSelectable Boolean? @map("canonical_pdf_text_selectable") // pdf.js text-layer probe; null = not yet probed

  // AI results (denormalized for list views)
  detectionCount Int   @default(0)
  avgConfidence  Float @default(0)

  // Assignment
  assigneeId String?
  assignee   User?   @relation("DocumentAssignee", fields: [assigneeId], references: [id])

  // Duplicate handling
  duplicateGroup String?
  contentHash    String?

  // Document content for review (DocParagraph[] as JSON)
  contentJson Json?

  // AI document-level classification (DocumentClassification as JSON)
  classification Json?

  // Processing timing
  processingStartedAt   DateTime?
  processingCompletedAt DateTime?
  extractionMs          Int?
  patternDetectionMs    Int?
  aiDetectionMs         Int?
  totalProcessingMs     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batch      Batch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  pages      DocumentPage[]
  detections Detection[]

  @@index([batchId])
  @@index([status])
  @@index([contentHash])
  @@index([canonicalPdfSha256])
  @@map("documents")
}

model DocumentPage {
  id         String @id @default(cuid())
  documentId String
  pageNumber Int
  text       String
  layoutJson Json?
  width      Float?
  height     Float?

  createdAt DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, pageNumber])
  @@index([documentId])
  @@map("document_pages")
}

model Detection {
  id            String  @id @default(cuid())
  documentId    String
  type          String
  text          String
  confidence    Float
  page          Int
  posX          Float   @default(0)
  posY          Float   @default(0)
  posW          Float   @default(0)
  posH          Float   @default(0)
  status        String  @default("pending")
  reasoning     String  @default("")
  aiExplanation String  @default("")
  source        String  @default("ai")
  note          String? // free-form reviewer rationale (replaces suggestedGround/appliedGround/piConsideration)
  // Phase 12.4 — ±100-char window of page text around the detection's
  // text span, captured at detection-write time. Drives cluster
  // disambiguation in the Tray expand view (e.g. "Sarah Mitchell from
  // Finance" vs "Sarah Mitchell the complainant"). Nullable because
  // AI paraphrase / normalised-punctuation captures sometimes have no
  // exact substring match in the source page text.
  pageContext   String?

  reviewedBy String?
  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  document Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  history  DetectionHistory[]

  @@index([documentId])
  @@index([status])
  // Phase 12.4 — Tray cluster grouping (`GROUP BY type, text`).
  @@index([type, text])
  @@map("detections")
}

model AuditEntry {
  id            String   @id @default(cuid())
  timestamp     DateTime @default(now())
  userId        String?
  userName      String
  userRole      String
  type          String
  description   String
  target        String
  batchId       String?
  detail        String?
  previousValue String?
  newValue      String?
  integrityHash String?  // SHA-256 hash of this entry + previous hash
  previousHash  String?  // Hash of the prior entry (null for first entry)

  user  User?  @relation(fields: [userId], references: [id])
  batch Batch? @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([timestamp])
  @@index([userId])
  @@map("audit_entries")
}

model FileUpload {
  id         String   @id @default(cuid())
  batchId    String
  filename   String
  mimeType   String
  sizeBytes  Int
  storageKey String   @unique
  sha256Hash String?
  createdAt  DateTime @default(now())

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@map("file_uploads")
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String   @default("system")

  @@map("system_settings")
}

model DetectionHistory {
  id            String   @id @default(cuid())
  detectionId   String
  field         String
  previousValue String?
  newValue      String?
  changedBy     String
  changedAt     DateTime @default(now())

  detection Detection @relation(fields: [detectionId], references: [id], onDelete: Cascade)

  @@index([detectionId])
  @@map("detection_history")
}

model CustomRule {
  id          String  @id @default(cuid())
  name        String
  type        String  // "Keyword" | "Pattern" | "Entity" | "Combination"
  status      String  @default("Draft") // "Active" | "Draft" | "Disabled"
  matchMode   String  @default("Exact") // "Exact" | "Fuzzy" | "Regex"
  keywords    String  @default("")
  scope       String  @default("All Documents")
  priority    String  @default("Medium")
  note        String? // free-form reviewer note, surfaced in the Custom Rules admin UI
  description String  @default("")
  matchCount  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("custom_rules")
}

model BatchMilestone {
  id          String    @id @default(cuid())
  batchId     String
  stage       String    // "upload" | "review" | "export"
  completedAt DateTime?

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, stage])
  @@map("batch_milestones")
}

model ActivationCode {
  id              String    @id @default(cuid())
  codeHash        String
  status          String    @default("pending") // "pending" | "redeemed" | "revoked"
  orgName         String?   // Organisation name, e.g. "New Plymouth District Council"
  orgAbbreviation String?   // e.g. "NPDC"
  orgTenantId     String?   // Azure AD tenant ID bound to this code
  allowedDomain   String?   // e.g. "npdc.govt.nz"
  redeemedAt      DateTime?
  redeemedBy      String?
  createdAt       DateTime  @default(now())
  expiresAt       DateTime?

  @@index([status])
  @@map("activation_codes")
}

model UserInvitation {
  id         String    @id @default(cuid())
  email      String
  name       String?
  role       String    @default("reviewer")
  invitedBy  String
  status     String    @default("pending") // "pending" | "accepted" | "expired" | "revoked"
  token      String    @unique
  acceptedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([email])
  @@index([status])
  @@map("user_invitations")
}

model ExportJob {
  id          String    @id @default(cuid())
  batchId     String
  status      String    @default("pending") // pending | generating | verifying | complete | error
  progress    Int       @default(0) // 0-100
  currentStep String?
  error       String?
  storageKey  String?   // blob/local storage key for the ZIP
  sha256      String?
  filename    String?
  docResults  Json?     // per-document success/failure log
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@map("export_jobs")
}

// PurgeLog survives the cascade-delete of its source Batch (no FK).
// Phase 6c's retention worker writes one row per purged batch with
// the audit-archive blob path + integrity result. Phase 6a creates
// the table; rows only start appearing once 6c lands.
model PurgeLog {
  id           String   @id @default(cuid())
  batchId      String   // historical reference, no FK (the Batch is gone by now)
  batchRef     String   // e.g. "BATCH-2026-014"
  archivePath  String   // blob path produced by the retention worker
  totalEntries Int      // audit-chain entry count at archive time
  chainValid   Boolean  // outcome of the integrity verification step
  archivedBy   String   // userId or "system"
  archivedAt   DateTime @default(now())

  @@index([archivedAt])
  @@map("purge_log")
}
