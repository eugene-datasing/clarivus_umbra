generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// MODELS
// ============================================================

model User {
  id           String   @id @default(cuid())
  name         String
  email        String?  @unique
  passwordHash String?
  role         String   @default("reviewer")
  departmentId String?
  azureAdOid   String?  @unique
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department        Department?      @relation(fields: [departmentId], references: [id])
  assignedDocuments Document[]       @relation("DocumentAssignee")
  auditEntries      AuditEntry[]
  caseAssignments   CaseAssignment[] @relation("caseAssignments")

  @@map("users")
}

model Department {
  id           String   @id @default(cuid())
  name         String   @unique
  contactEmail String?
  headName     String?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users           User[]
  caseAssignments CaseAssignment[]

  @@map("departments")
}

model Case {
  id             String   @id @default(cuid())
  reference      String   @unique
  requesterName  String
  requesterType  String
  dateReceived   DateTime
  deadline       DateTime
  priority       String   @default("standard")
  departments    String[]
  description    String
  status         String   @default("draft")

  // Denormalized counters
  documentCount  Int @default(0)
  reviewedCount  Int @default(0)
  redactionCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents        Document[]
  auditEntries     AuditEntry[]
  feedbackExamples FeedbackExample[]
  milestones       CaseMilestone[]
  caseAssignments  CaseAssignment[]
  exportJobs       ExportJob[]

  @@map("cases")
}

model Document {
  id             String  @id @default(cuid())
  caseId         String
  name           String
  fileType       String
  mimeType       String  @default("application/octet-stream")
  sizeBytes      Int     @default(0)
  pageCount      Int     @default(0)
  status         String  @default("pending")
  originalPath   String?
  processingError String?

  // AI results (denormalized for list views)
  detectionCount Int   @default(0)
  avgConfidence  Float @default(0)

  // Assignment
  assigneeId String?
  assignee   User?  @relation("DocumentAssignee", fields: [assigneeId], references: [id])

  // Duplicate handling
  duplicateGroup String?
  contentHash    String?

  // Document content for review (DocParagraph[] as JSON)
  contentJson Json?

  // AI document-level classification (DocumentClassification as JSON)
  classification Json?

  // Processing timing (WP13)
  processingStartedAt  DateTime?
  processingCompletedAt DateTime?
  extractionMs         Int?
  patternDetectionMs   Int?
  aiDetectionMs        Int?
  totalProcessingMs    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  case             Case              @relation(fields: [caseId], references: [id], onDelete: Cascade)
  pages            DocumentPage[]
  detections       Detection[]
  snapshots        DetectionSnapshot[]
  feedbackExamples FeedbackExample[]

  @@index([caseId])
  @@index([status])
  @@index([contentHash])
  @@map("documents")
}

model DocumentPage {
  id         String @id @default(cuid())
  documentId String
  pageNumber Int
  text       String
  layoutJson Json?
  width      Float?
  height     Float?

  createdAt DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, pageNumber])
  @@index([documentId])
  @@map("document_pages")
}

model Detection {
  id              String  @id @default(cuid())
  documentId      String
  type            String
  text            String
  confidence      Float
  page            Int
  posX            Float   @default(0)
  posY            Float   @default(0)
  posW            Float   @default(0)
  posH            Float   @default(0)
  suggestedGround String?
  appliedGround   String?
  status          String  @default("pending")
  reasoning       String  @default("")
  piConsideration String  @default("")
  aiExplanation   String  @default("")
  source          String  @default("ai")

  reviewedBy String?
  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  document        Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  history         DetectionHistory[]
  feedbackExample FeedbackExample?

  @@index([documentId])
  @@index([status])
  @@map("detections")
}

model AuditEntry {
  id            String   @id @default(cuid())
  timestamp     DateTime @default(now())
  userId        String?
  userName      String
  userRole      String
  type          String
  description   String
  target        String
  caseId        String?
  detail        String?
  previousValue String?
  newValue      String?
  integrityHash String?  // SHA-256 hash of this entry + previous hash
  previousHash  String?  // Hash of the prior entry (null for first entry)

  user User? @relation(fields: [userId], references: [id])
  case Case? @relation(fields: [caseId], references: [id])

  @@index([caseId])
  @@index([timestamp])
  @@index([userId])
  @@map("audit_entries")
}

model FileUpload {
  id         String   @id @default(cuid())
  filename   String
  mimeType   String
  sizeBytes  Int
  storageKey String   @unique
  sha256Hash String?
  createdAt  DateTime @default(now())

  @@map("file_uploads")
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String   @default("system")

  @@map("system_settings")
}

model DetectionHistory {
  id            String   @id @default(cuid())
  detectionId   String
  field         String
  previousValue String?
  newValue      String?
  changedBy     String
  changedAt     DateTime @default(now())

  detection Detection @relation(fields: [detectionId], references: [id], onDelete: Cascade)

  @@index([detectionId])
  @@map("detection_history")
}

model CustomRule {
  id              String   @id @default(cuid())
  name            String
  type            String   // "Keyword" | "Pattern" | "Entity" | "Combination"
  status          String   @default("Draft") // "Active" | "Draft" | "Disabled"
  matchMode       String   @default("Exact") // "Exact" | "Fuzzy" | "Regex"
  keywords        String   @default("")
  scope           String   @default("All Documents")
  priority        String   @default("Medium")
  suggestedGround String?
  description     String   @default("")
  matchCount      Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("custom_rules")
}

model CaseMilestone {
  id          String    @id @default(cuid())
  caseId      String
  stage       String    // collection, processing, initial-review, senior-review, final-approval, release
  label       String
  targetDate  DateTime
  completedAt DateTime?
  sortOrder   Int

  case        Case             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  assignments CaseAssignment[]

  @@unique([caseId, stage])
  @@index([caseId])
  @@map("case_milestones")
}

model CaseAssignment {
  id           String   @id @default(cuid())
  caseId       String
  milestoneId  String
  type         String   // "user" or "department"
  userId       String?
  departmentId String?
  role         String?  // "lead-reviewer", "sme-reviewer", "senior-reviewer", "final-approver"
  assignedAt   DateTime @default(now())
  assignedBy   String

  case       Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  milestone  CaseMilestone  @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  user       User?          @relation("caseAssignments", fields: [userId], references: [id])
  department Department?    @relation(fields: [departmentId], references: [id])

  @@index([caseId])
  @@index([milestoneId])
  @@map("case_assignments")
}

model DetectionSnapshot {
  id             String   @id @default(cuid())
  documentId     String
  snapshotType   String   // "draft" | "final"
  createdBy      String
  detectionsJson Json     // Array of detection states at snapshot time
  createdAt      DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("detection_snapshots")
}

model FeedbackExample {
  id          String   @id @default(cuid())
  caseId      String?
  documentId  String
  detectionId String   @unique
  type        String   // Detection type: "personal-name", "phone", etc.
  text        String   // The missed text that was manually detected
  ground      String?  // LGOIMA withholding ground
  reasoning   String   @default("")
  createdBy   String
  createdAt   DateTime @default(now())

  case      Case?     @relation(fields: [caseId], references: [id], onDelete: SetNull)
  document  Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  detection Detection @relation(fields: [detectionId], references: [id], onDelete: Cascade)

  @@index([type])
  @@index([createdAt])
  @@map("feedback_examples")
}

model ActivationCode {
  id              String    @id @default(cuid())
  codeHash        String
  status          String    @default("pending") // "pending" | "redeemed" | "revoked"
  orgName         String?   // Organisation name, e.g. "New Plymouth District Council"
  orgAbbreviation String?   // e.g. "NPDC"
  orgTenantId     String?   // Azure AD tenant ID bound to this code
  allowedDomain   String?   // e.g. "npdc.govt.nz"
  redeemedAt      DateTime?
  redeemedBy      String?
  createdAt       DateTime  @default(now())
  expiresAt       DateTime?

  @@index([status])
  @@map("activation_codes")
}

model UserInvitation {
  id           String    @id @default(cuid())
  email        String
  name         String?
  role         String    @default("reviewer")
  departmentId String?
  invitedBy    String
  status       String    @default("pending") // "pending" | "accepted" | "expired" | "revoked"
  token        String    @unique
  acceptedAt   DateTime?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  @@index([email])
  @@index([status])
  @@map("user_invitations")
}

model ExportJob {
  id            String    @id @default(cuid())
  caseId        String
  case          Case      @relation(fields: [caseId], references: [id])
  status        String    @default("pending") // pending | generating | verifying | complete | error
  packageType   String    @default("requester") // requester | internal | ombudsman
  progress      Int       @default(0) // 0-100
  currentStep   String?
  error         String?
  storageKey    String?   // blob/local storage key for the ZIP
  sha256        String?
  filename      String?
  documentIds   Json?     // string[] of included document IDs
  docResults    Json?     // per-document success/failure log
  batchGroupId  String?   // links batched exports together
  batchNumber   Int?      // 1-based index within a batch group
  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  @@index([caseId])
  @@index([batchGroupId])
  @@map("export_jobs")
}

model ProcessingJob {
  id          String    @id @default(cuid())
  docId       String
  status      String    @default("queued") // "queued" | "processing" | "complete" | "error"
  step        String    @default("Waiting in queue")
  progress    Int       @default(0) // 0-100
  attempt     Int       @default(0)
  maxAttempts Int       @default(3)
  error       String?
  enqueuedAt  DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  @@index([docId])
  @@index([status])
  @@map("processing_jobs")
}
